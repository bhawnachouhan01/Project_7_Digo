# Digo - example environment configuration
#
# The application runs with NO environment variables set. Everything it needs
# (the model, its metadata, the dataset) is read from paths resolved relative to
# the project root by src/config.py.
#
# This file documents the few optional settings that exist. Copy it to `.env`
# only if you actually want to change one:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Optional: override where the dataset is read from.
# Useful if you keep the CSV outside the repository.
# ---------------------------------------------------------------------------
# DIGO_DATA_FILE=data/twitter_disaster.csv

# ---------------------------------------------------------------------------
# Optional: Hugging Face token.
# Only needed if you re-run the DistilBERT section of the notebook and hit
# anonymous rate limits. The deployed app does NOT use Hugging Face at all.
# ---------------------------------------------------------------------------
# HF_TOKEN=

# ---------------------------------------------------------------------------
# Optional: logging level for the Streamlit app (INFO, WARNING, ERROR).
# ---------------------------------------------------------------------------
# DIGO_LOG_LEVEL=INFO
