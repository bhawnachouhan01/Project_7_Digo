# ---------------------------------------------------------------------------
# Virtual environment
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Testing / coverage
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---------------------------------------------------------------------------
# Logs (kept local; the folder itself is tracked via logs/.gitkeep)
# ---------------------------------------------------------------------------
logs/*
!logs/.gitkeep
*.log

# ---------------------------------------------------------------------------
# Secrets - never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.toml
.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Large model artifacts
# ---------------------------------------------------------------------------
# models/selected_model.joblib IS committed deliberately - it is ~1 MB and the
# deployed Streamlit app needs it. Everything heavy stays out.
models/distilbert*/
models/*.bin
models/*.safetensors
models/*.pt
models/*.pth
models/*.h5
models/*.onnx
*.w2v
*.kv
*.npy

# Hugging Face / torch caches
.cache/
hf_cache/
transformers_cache/

# ---------------------------------------------------------------------------
# Local-only project files
# ---------------------------------------------------------------------------
# This repository is kept to the minimum the Streamlit app needs to run, so the
# deployed build stays small and fast. Everything below still lives on the
# development machine - it is simply not published.
#
# To publish any of them later:  git add -f <path>
data/
notebooks/
tests/
# All 20 EDA / evaluation charts are published; the raw comparison CSV is not.
# NOTE: this must be "reports/*", not "reports/" - git will not descend into a
# blanket-ignored directory, so a "!" exception inside it would never match.
reports/*
!reports/figures/
make_presentation.py
PROJECT_PRESENTATION.md
*.pptx
pytest.ini
requirements-dev.txt
.env.example
# Modules used only by the notebook, not by the app
src/modeling.py
src/evaluation.py

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
