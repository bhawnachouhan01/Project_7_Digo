# ---------------------------------------------------------------------------
# Virtual environment
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Testing / coverage
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---------------------------------------------------------------------------
# Logs (kept local; the folder itself is tracked via logs/.gitkeep)
# ---------------------------------------------------------------------------
logs/*
!logs/.gitkeep
*.log

# ---------------------------------------------------------------------------
# Secrets - never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.toml
.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Large model artifacts
# ---------------------------------------------------------------------------
# models/selected_model.joblib IS committed deliberately - it is ~1 MB and the
# deployed Streamlit app needs it. Everything heavy stays out.
models/distilbert*/
models/*.bin
models/*.safetensors
models/*.pt
models/*.pth
models/*.h5
models/*.onnx
*.w2v
*.kv
*.npy

# Hugging Face / torch caches
.cache/
hf_cache/
transformers_cache/

# ---------------------------------------------------------------------------
# Local-only files
# ---------------------------------------------------------------------------
# The repository holds the project-submission deliverables plus everything the
# Streamlit app needs. The few items below are build scaffolding or temporary
# files and are deliberately not published.
#
# To publish any of them later:  git add -f <path>

# Build script that regenerates the presentation - not a deliverable
make_presentation.py

# Documents optional environment variables; the app requires none
.env.example

# All 20 EDA / evaluation charts are published; the raw comparison CSV is not.
# NOTE: this must be "reports/*", not "reports/" - git will not descend into a
# blanket-ignored directory, so a "!" exception inside it would never match.
reports/*
!reports/figures/

# Office lock files, created while a document is open
~$*

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
